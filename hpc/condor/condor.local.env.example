# Connection to the condor access point, used by hpc/condor/dashboard/server.py.
# Copy to hpc/condor/condor.local.env (gitignored, never commit it) and fill in, or just start the dashboard:
# it asks for these values once and writes that file.
CONDOR_HOST=<access point host name>
CONDOR_PORT=<ssh port>
CONDOR_USER=<your login>
CONDOR_REMOTE_DIR=DisorderKit.jl
